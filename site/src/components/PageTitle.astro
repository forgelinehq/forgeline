---
// The page heading, with what docs.openclaw.ai shows above it: breadcrumbs from the sidebar, the section as a small
// label, and a "Copy page" menu (copy the Markdown, view it, or open the page in ChatGPT or Claude to ask about it).
import Default from '@astrojs/starlight/components/PageTitle.astro';

const route = Astro.locals.starlightRoute;
type Entry = { type: string; label: string; isCurrent?: boolean; entries?: Entry[] };
function trailTo(items: Entry[], trail: string[] = []): string[] | null {
  for (const it of items) {
    if (it.type === 'link' && it.isCurrent) return trail;
    if (it.type === 'group' && it.entries) {
      const found = trailTo(it.entries, [...trail, it.label]);
      if (found) return found;
    }
  }
  return null;
}
const trail = trailTo(route.sidebar as Entry[]) ?? [];
const slug = route.id === 'index' ? '' : route.id;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const md = `${base}/${slug || 'index'}.md`;
const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const ask = encodeURIComponent(`Read ${pageURL} (the Forgeline documentation) and answer my questions about it.`);
---
{slug && (
  <div class="fl-title-bar">
    <nav class="fl-crumbs" aria-label="Breadcrumbs">
      {trail.map((t) => <span>{t}</span>)}
      <span aria-current="page">{route.entry.data.title}</span>
    </nav>
    <fl-copy-page class="fl-copy" data-md={md}>
      <button type="button" class="fl-copy-main" data-copy>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
        <span data-label>Copy page</span>
      </button>
      <details class="fl-copy-more">
        <summary aria-label="More ways to use this page">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="fl-copy-menu" role="menu">
          <a role="menuitem" href={md} target="_blank" rel="noopener"><b>View as Markdown</b><span>This page as plain text</span></a>
          <a role="menuitem" href={`https://chatgpt.com/?hints=search&q=${ask}`} target="_blank" rel="noopener"><b>Open in ChatGPT</b><span>Ask questions about this page</span></a>
          <a role="menuitem" href={`https://claude.ai/new?q=${ask}`} target="_blank" rel="noopener"><b>Open in Claude</b><span>Ask questions about this page</span></a>
        </div>
      </details>
    </fl-copy-page>
  </div>
)}
{slug && trail.length > 0 && <p class="fl-eyebrow">{trail[trail.length - 1]}</p>}
<Default />

<script>
  class CopyPage extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-copy]');
      const label = this.querySelector<HTMLElement>('[data-label]');
      button?.addEventListener('click', async () => {
        try {
          const text = await (await fetch(this.dataset.md!)).text();
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = 'Copied';
        } catch {
          if (label) label.textContent = 'Could not copy';
        }
        setTimeout(() => { if (label) label.textContent = 'Copy page'; }, 2000);
      });
      // Close the menu when clicking elsewhere.
      document.addEventListener('click', (e) => {
        const menu = this.querySelector('details');
        if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    }
  }
  customElements.define('fl-copy-page', CopyPage);
</script>
