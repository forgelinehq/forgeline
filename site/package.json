{
  "name": "forgeline-docs",
  "private": true,
  "type": "module",
  "description": "The Forgeline documentation site (Starlight). Pages are written in ../docs and copied in by scripts/sync.mjs.",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "node scripts/sync.mjs && astro dev",
    "build": "node scripts/sync.mjs && astro build",
    "test": "node --test scripts/sync.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.7"
  },
  "engines": {
    "node": ">=22"
  }
}
